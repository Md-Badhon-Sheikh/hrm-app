# Used only when the domain's document root is this project folder
# (e.g. cPanel subdomain pointing at /hrm-backend). Every request is sent
# into /public, and the app's private files can never be downloaded.
# If the document root already points at /public, this file is ignored.

Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Keep the Bearer token (mobile app login) when Apache runs PHP via CGI/FPM
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Force HTTPS on the live domain only (local XAMPP keeps working on http)
    RewriteCond %{HTTP_HOST} ^hr\.webase\.info$ [NC]
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Block dot-files/folders (.env, .git ...) except Let's Encrypt checks
    RewriteRule (^|/)\.(?!well-known(/|$)) - [F,L]

    # Block the app's private folders if someone asks for them directly
    RewriteRule ^(app|bootstrap|config|database|resources|routes|storage|tests|vendor|node_modules)(/|$) - [F,L]

    # Everything else is served from /public
    RewriteRule ^$ public/ [L]
    RewriteRule ^((?!public/).*)$ public/$1 [L,NC]
</IfModule>

# Never serve config/secret files even if mod_rewrite is off
<FilesMatch "^(\.env.*|composer\.(json|lock)|package(-lock)?\.json|artisan|phpunit\.xml|vite\.config\.js|.*\.(md|log|sql|sh|yml|yaml))$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
